/* publish-activity/publish-activity.wxss */
.publish-container {
    padding: 24rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  .form-item {
    background-color: #ffffff;
    padding: 24rpx;
    border-radius: 16rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
  }
  
  .form-label {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #333333;
    margin-bottom: 16rpx;
  }
  
  .form-input {
    width: 100%;
    font-size: 26rpx;
    color: #333333;
    padding: 12rpx 0;
    border-bottom: 1rpx solid #eeeeee;
    box-sizing: border-box;
  }
  
  .form-input::placeholder {
    color: #999999;
    font-size: 24rpx;
  }
  
  .form-picker {
    width: 100%;
    height: 60rpx;
    display: block;
    cursor: pointer;
  }
  
  /* 拆分日期+时间的容器样式 */
  .time-split-group {
    display: flex;
    flex-direction: column; /* 上下排列，避免挤压 */
    gap: 12rpx;
  }
  
  /* 拆分后的picker样式（确保点击区域） */
  .split-picker {
    width: 100%;
    height: 80rpx;
    display: block;
    cursor: pointer;
    background-color: #f8f8f8;
    border-radius: 8rpx;
    padding: 0 16rpx;
    box-sizing: border-box;
  }
  
  .picker-content {
    font-size: 26rpx;
    color: #333333;
    padding: 24rpx 0;
    width: 100%;
    height: 100%;
    line-height: 32rpx;
    box-sizing: border-box;
  }
  
  .form-textarea {
    width: 100%;
    font-size: 26rpx;
    color: #333333;
    min-height: 180rpx;
    border: 1rpx solid #eeeeee;
    border-radius: 8rpx;
    padding: 16rpx;
    resize: none;
    box-sizing: border-box;
  }
  
  .form-textarea::placeholder {
    color: #999999;
    font-size: 24rpx;
  }
  
  .upload-img {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 0;
    border: 2rpx dashed #dddddd;
    border-radius: 12rpx;
    cursor: pointer;
  }
  
  .upload-img-src {
    width: 120rpx;
    height: 120rpx;
    object-fit: contain;
    margin-bottom: 16rpx;
  }
  
  .upload-text {
    font-size: 24rpx;
    color: #999999;
  }
  
  .submit-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background-color: #1a73e8;
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 44rpx;
    border: none;
    margin-top: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.3);
  }