/* 整体容器 */
.container {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #f5f7fa;
    box-sizing: border-box;
    padding: 20rpx;
  }
  
  /* 输入框区域 */
  .input-wrap {
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  /* 单个输入项 */
  .input-item {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
  }
  
  /* 输入框标签 */
  .label {
    font-size: 28rpx;
    color: #333333;
    width: 160rpx;
  }
  
  /* 输入框样式 */
  .input {
    flex: 1;
    height: 80rpx;
    border: 1rpx solid #e5e7eb;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 26rpx;
    color: #333333;
    box-sizing: border-box;
  }

  /* 新增：路径规划选项容器 */
  .plan-option-wrap {
    margin: 20rpx 0 30rpx 0;
    border-top: 1rpx solid #e5e7eb;
    padding-top: 30rpx;
  }

  /* 新增：单个规划选项 */
  .option-item {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }

  /* 新增：选项标签 */
  .option-label {
    font-size: 28rpx;
    color: #333333;
    width: 160rpx;
  }

  /* 新增：选项列表 */
  .option-list {
    flex: 1;
    display: flex;
    gap: 20rpx;
  }

  /* 新增：选项按钮 */
  .option-btn {
    padding: 15rpx 25rpx;
    background-color: #f5f7fa;
    border-radius: 8rpx;
    font-size: 26rpx;
    color: #666666;
    cursor: pointer;
  }

  /* 新增：选中的选项按钮 */
  .option-btn.active {
    background-color: #07c160;
    color: #ffffff;
  }
  
  /* 确定按钮 */
  .confirm-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background-color: #07c160;
    color: #ffffff;
    border-radius: 8rpx;
    font-size: 30rpx;
    border: none;
    margin-top: 10rpx;
  }
  
  .confirm-btn::after {
    border: none;
  }
  
  /* 距离显示区域 */
  .distance-show {
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 20rpx 30rpx;
    margin-bottom: 20rpx;
    font-size: 28rpx;
    color: #333333;
    text-align: center;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }

  /* 新增：路径规划结果显示 */
  .plan-result-show {
    background-color: #ffffff;
    border-radius: 16rpx;
    padding: 20rpx 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }

  /* 新增：规划结果项 */
  .result-item {
    font-size: 26rpx;
    color: #333333;
    margin-bottom: 10rpx;
  }

  .result-item:last-child {
    margin-bottom: 0;
  }
  
  /* 地图区域 */
  .map-wrap {
    flex: 1;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  /* 地图样式 */
  .map {
    width: 100%;
    height: 100%;
  }