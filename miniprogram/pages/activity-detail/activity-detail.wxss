/* pages/activity-detail/activity-detail.wxss */
.detail-scroll {
    height: calc(100vh - 100rpx);
    background-color: #f5f5f5;
  }
  
  .detail-img {
    width: 100%;
    height: auto;
    min-height: 280rpx;
    max-height: 320rpx;
    background-color: #eee;
  }
  
  .detail-container {
    padding: 24rpx;
    background-color: #ffffff;
    margin-bottom: 20rpx;
    border-radius: 16rpx 16rpx 0 0;
  }
  
  .detail-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333333;
    margin-bottom: 20rpx;
    line-height: 1.4;
  }
  
  .detail-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 20rpx;
  }
  
  .tag-item {
    padding: 8rpx 20rpx;
    background-color: #f0f7ff;
    color: #1a73e8;
    font-size: 24rpx;
    border-radius: 20rpx;
  }
  
  .detail-location {
    display: flex;
    align-items: center;
    font-size: 26rpx;
    color: #666666;
    margin-bottom: 30rpx;
  }
  
  .location-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 12rpx;
  }
  
  .desc-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #333333;
    margin-bottom: 16rpx;
  }
  
  .desc-content {
    font-size: 26rpx;
    color: #666666;
    line-height: 1.8;
    margin-bottom: 30rpx;
    white-space: pre-wrap;
  }
  
  .detail-count {
    font-size: 26rpx;
    color: #1a73e8;
    margin-bottom: 20rpx;
  }
  
  .status-end, .status-full {
    color: #ff4d4f;
    margin-left: 12rpx;
    font-weight: 400;
  }
  
  .btn-container {
    padding: 20rpx 24rpx;
    background-color: #ffffff;
    border-top: 1rpx solid #f5f5f5;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
  }
  
  .apply-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background-color: #1a73e8;
    color: #ffffff;
    font-size: 32rpx;
    border-radius: 44rpx;
    border: none;
  }
  
  .disabled-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background-color: #f5f5f5;
    color: #999999;
    font-size: 32rpx;
    border-radius: 44rpx;
    border: none;
  }