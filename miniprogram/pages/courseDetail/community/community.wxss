/* 全局样式重置 */
page {
    min-height: 100vh;
    padding: 0;
    margin: 0;
    background-color: #f5f5f5;
    display: flex;
    flex-direction: column;
    /* 适配全面屏底部安全区 */
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: border-box;
  }
  
 /* 2. 容器：占满页面剩余空间 */
.container {
    flex: 1; 
    width: 100%;
    padding: 20rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }
  
  /* 发布按钮区域 */
  .publish-btn-wrap {
    width: 100%;
    margin-bottom: 20rpx;
  }
  .publish-btn {
    width: 100%;
    background-color: #1aad19;
    color: #fff;
    border-radius: 8rpx;
    padding: 20rpx 0;
    font-size: 28rpx;
    border: none;
  }
  

.community-list {
    flex: 1; /* 占满容器剩余高度 */
    background-color: #fff;
    border-radius: 100rpx;
    padding: 30rpx;
    overflow-y: auto; /* 内容过多时滚动 */
    -webkit-overflow-scrolling: touch; /* 优化 iOS 滚动体验 */
  }
.dynamic-item {
    width: 100%;
    padding-bottom: 20rpx;
    margin-bottom: 20rpx;
    border-bottom: 10rpx solid #f0f0f0;
    box-sizing: border-box;
  }
  .dynamic-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  /* 发布者信息 */
  .publisher-info {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
  }
  .avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 16rpx;
  }
  .info-wrap .nickname {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 4rpx;
  }
  .info-wrap .publish-time {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 动态内容 */
  .dynamic-content .content-text {
    font-size: 26rpx;
    color: #333;
    line-height: 40rpx;
    margin-bottom: 16rpx;
  }
  .content-images {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
  }
  .content-img {
    width: 220rpx;
    height: 220rpx;
    border-radius: 8rpx;
  }
  
  /* 互动区域（点赞+评论） */
  .dynamic-interact {
    display: flex;
    gap: 40rpx;
    margin: 16rpx 0;
  }
  .like-btn, .comment-btn {
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 24rpx;
  }
  .like-text.liked {
    color: #e53935;
  }
  .comment-text {
    color: #999;
  }
  
  /* 评论列表 */
  .comment-list {
    width: 100%;
    margin-top: 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
  }
  .comment-empty {
    font-size: 24rpx;
    color: #999;
    text-align: center;
    padding: 10rpx 0;
  }
  .comment-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 12rpx;
  }
  .comment-avatar image {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    margin-right: 12rpx;
  }
  .comment-content {
    flex: 1;
    background-color: #f5f5f5;
    border-radius: 8rpx;
    padding: 12rpx;
  }
  .comment-nickname {
    font-size: 22rpx;
    color: #666;
    margin-bottom: 4rpx;
  }
  .comment-text {
    font-size: 24rpx;
    color: #333;
    line-height: 32rpx;
    margin-bottom: 4rpx;
  }
  .comment-time {
    font-size: 20rpx;
    color: #999;
  }
  .more-comment {
    font-size: 24rpx;
    color: #1aad19;
    text-align: center;
    margin-top: 8rpx;
    padding: 8rpx 0;
  }
  
  /* 加载中样式 */
  .loading-wrap {
    width: 100%;
    text-align: center;
    padding: 50rpx 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .loading-icon {
    margin-bottom: 16rpx;
  }
  .loading-text {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 弹窗遮罩层 */
  .modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }
  
  /* 弹窗容器：居中显示 */
  .modal-wrap {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 600rpx;
    background-color: #fff;
    border-radius: 12rpx;
    z-index: 1000;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }
  
  /* 弹窗头部 */
  .modal-header {
    padding: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .modal-title {
    font-size: 30rpx;
    font-weight: bold;
  }
  .modal-close {
    font-size: 36rpx;
    color: #999;
    width: 60rpx;
    height: 60rpx;
    line-height: 60rpx;
    text-align: center;
  }
  
  /* 弹窗评论列表 */
  .modal-comment-list {
    flex: 1;
    overflow-y: auto;
    padding: 0 20rpx;
    margin-top: 10rpx;
  }
  .modal-comment-empty {
    padding: 20rpx;
    text-align: center;
    font-size: 24rpx;
    color: #999;
  }
  
  /* 弹窗内容区 */
  .modal-content {
    padding: 20rpx;
  }
  .publish-textarea, .comment-textarea {
    width: 100%;
    min-height: 120rpx;
    padding: 12rpx;
    border: 1rpx solid #f0f0f0;
    border-radius: 8rpx;
    font-size: 26rpx;
    box-sizing: border-box;
  }
  
  /* 图片上传区域 */
  .upload-wrap {
    margin-top: 20rpx;
  }
  .upload-title {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 12rpx;
  }
  .upload-images {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
  }
  .upload-img {
    width: 120rpx;
    height: 120rpx;
    border-radius: 8rpx;
  }
  .upload-btn {
    width: 120rpx;
    height: 120rpx;
    border: 1rpx dashed #ccc;
    border-radius: 8rpx;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  /* 弹窗底部按钮 */
  .modal-footer {
    padding: 20rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    gap: 20rpx;
  }
  .modal-btn {
    flex: 1;
    padding: 16rpx 0;
    border-radius: 8rpx;
    font-size: 26rpx;
    border: none;
  }
  .cancel-btn {
    background-color: #f5f5f5;
    color: #666;
  }
  .confirm-btn {
    background-color: #1aad19;
    color: #fff;
  }