/* pages/poi-search/poi-search.wxss */
.container {
    padding: 16rpx 16rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
  }
  
  /* 搜索栏样式 */
  .search-bar {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    padding: 12rpx 20rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    border: 1rpx solid #f0f0f0;
  }
  
  .search-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
  }
  
  .search-input {
    flex: 1;
    font-size: 28rpx;
    padding: 12rpx 0 12rpx 40rpx;
    color: #333;
    line-height: 40rpx;
    background: transparent;
  }
  
  .clear-icon {
    position: absolute;
    right: 0;
    font-size: 28rpx;
    color: #999;
    width: 44rpx;
    height: 44rpx;
    text-align: center;
    line-height: 44rpx;
    border-radius: 50%;
    background-color: #f5f5f5;
    transition: all 0.2s ease;
  }
  
  .clear-icon:active {
    background-color: #e8e8e8;
    transform: scale(0.95);
  }
  
  .search-btn {
    background: linear-gradient(135deg, #1aad19 0%, #179b17 100%);
    color: #fff;
    border: none;
    border-radius: 12rpx;
    padding: 14rpx 32rpx;
    font-size: 26rpx;
    margin-left: 16rpx;
    line-height: 36rpx;
    box-shadow: 0 2rpx 8rpx rgba(26, 173, 25, 0.2);
    transition: all 0.2s ease;
  }
  
  .search-btn:active {
    transform: scale(0.98);
    box-shadow: 0 1rpx 4rpx rgba(26, 173, 25, 0.2);
  }
  
  /* 分类滚动样式 */
  .category-scroll {
    white-space: nowrap;
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    padding: 16rpx 0;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    border: 1rpx solid #f0f0f0;
  }
  
  .category-wrap {
    display: inline-flex;
    padding: 0 20rpx;
    gap: 12rpx;
  }
  
  .category-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12rpx 32rpx;
    font-size: 26rpx;
    color: #666;
    border-radius: 30rpx;
    background-color: #f5f5f5;
    transition: all 0.3s ease;
    white-space: nowrap;
  }
  
  .category-item.active {
    background: linear-gradient(135deg, #1aad19 0%, #179b17 100%);
    color: #fff;
    box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
    transform: translateY(-2rpx);
  }
  
  /* 分类图片样式 */
  .category-img {
    width: 60rpx;
    height: 60rpx;
    border-radius: 8rpx;
    object-fit: cover;
    margin-bottom: 8rpx;
    background-color: #f5f5f5;
  }
  
  /* 结果列表样式 */
  .result-wrap {
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    overflow: hidden;
    border: 1rpx solid #f0f0f0;
  }
  
  .result-item {
    display: flex;
    align-items: flex-start;
    padding: 24rpx 20rpx;
    border-bottom: 1rpx solid #f8f8f8;
    width: 100%;
    transition: background-color 0.2s ease;
  }
  
  .result-item:last-child {
    border-bottom: none;
  }
  
  .result-item:active {
    background-color: #f8f8f8;
  }
  
  /* 位置图标样式 */
  .poi-icon {
    margin-right: 16rpx;
    margin-top: 8rpx;
    color: #1aad19;
  }
  
  .poi-icon > icon {
    font-size: 24rpx !important;
  }
  
  /* 核心：POI信息区域（包含图片） */
  .poi-info {
    flex: 1;
    display: flex;
    margin-left: -16rpx;
  }
  .poi-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    object-fit: cover;
    border: 1rpx solid #f0f0f0;
    margin-bottom: 0;
    margin-right: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease;
    background-color: #f5f5f5;
  }
  .result-item:active .poi-image {
    transform: scale(0.98);
  }
  .poi-text-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* 文字信息样式 */
  .poi-name {
    font-size: 30rpx;
    color: #222;
    font-weight: 600;
    margin-bottom: 8rpx;
    line-height: 42rpx;
  }
  
  .poi-address {
    font-size: 24rpx;
    color: #888;
    margin-bottom: 6rpx;
    line-height: 34rpx;
  }
  
  .poi-distance {
    font-size: 22rpx;
    color: #1aad19;
    line-height: 28rpx;
    background-color: #f0f9f0;
    padding: 2rpx 8rpx;
    border-radius: 4rpx;
    align-self: flex-start;
  }
  
  /* 箭头图标 */
  .arrow-icon {
    margin-left: 12rpx;
    margin-top: 40rpx;
    color: #ccc;
    font-size: 24rpx !important;
  }
  
  /* 空状态样式 */
  .empty-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    margin-top: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    border: 1rpx solid #f0f0f0;
  }
  
  .empty-img {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 24rpx;
    opacity: 0.8;
  }
  
  .empty-text {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 32rpx;
  }
  
  .reset-btn {
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    color: #1aad19;
    border: 1rpx solid #1aad19;
    border-radius: 12rpx;
    padding: 12rpx 32rpx;
    font-size: 26rpx;
    transition: all 0.2s ease;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .reset-btn:active {
    background-color: #f0f9f0;
    transform: scale(0.98);
  }
  
  /* 加载中样式 */
  .loading-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0;
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    margin-top: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    border: 1rpx solid #f0f0f0;
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #999;
    margin-top: 20rpx;
  }
  
  /* 初始提示样式 */
  .init-tips {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 150rpx 0;
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    margin-top: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
    border: 1rpx solid #f0f0f0;
  }
  
  .tips-icon {
    font-size: 100rpx;
    margin-bottom: 24rpx;
    opacity: 0.8;
  }
  
  .tips-text {
    font-size: 30rpx;
    color: #999;
  }