.chat-list-container {
    padding: 0 24rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  .page-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #eee;
    margin-bottom: 16rpx;
  }
  
  .chat-item {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
    background-color: #fff;
    padding: 16rpx;
    border-radius: 8rpx;
    margin-bottom: 12rpx;
  }
  
  .avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 20rpx;
  }
  
  .chat-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8rpx;
  }
  
  .friend-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
  }
  
  .msg-time {
    font-size: 22rpx;
    color: #999;
  }
  
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .last-msg {
    font-size: 24rpx;
    color: #666;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 400rpx;
  }
  
  .unread-badge {
    width: 32rpx;
    height: 32rpx;
    line-height: 32rpx;
    text-align: center;
    background-color: #f44336;
    color: #fff;
    font-size: 20rpx;
    border-radius: 50%;
  }
  
  .empty-state {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 400rpx;
  }
  
  .empty-tip {
    font-size: 26rpx;
    color: #999;
  }