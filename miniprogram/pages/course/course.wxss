.course-container {
    padding: 20rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  .week-switch {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    padding: 15rpx;
    border-radius: 8rpx;
  }
  
  .week-switch button {
    padding: 10rpx 20rpx;
    background-color: #409eff;
    color: #fff;
    border: none;
    border-radius: 6rpx;
    font-size: 28rpx;
  }
  
  .week-switch button[disabled] {
    background-color: #ccc;
  }
  
  .current-week {
    font-size: 32rpx;
    font-weight: 600;
    margin: 0 30rpx;
    color: #333;
  }