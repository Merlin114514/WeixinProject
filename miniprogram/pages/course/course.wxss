/* 全局样式 */
page {
    background-color: #f5f7fa;
    font-family: PingFang SC, Microsoft YaHei, sans-serif;
  }
  
  /* 导航栏样式 */
  .refresh-btn {
    width: 48rpx;
    height: 48rpx;
    padding: 8rpx;
  }
  
  /* 主容器 */
  .container {
    padding: 16rpx;
  }
  
  /* 星期头部 */
  .week-list {
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 16rpx 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
    margin-bottom: 16rpx;
  }
  .now-month {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 80rpx;
    margin-right: 20rpx;
  }
  .now-month text:first-child {
    font-size: 32rpx;
    font-weight: 700;
    color: #30A2FF;
  }
  .now-month text:last-child {
    font-size: 20rpx;
    color: #718096;
  }
  .week-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8rpx 0;
    border-radius: 12rpx;
  }
  .week-item.active {
    background: #e8f4f8;
  }
  .week-name {
    font-size: 24rpx;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 4rpx;
  }
  .week-item.active .week-name {
    color: #30A2FF;
  }
  .week-date {
    font-size: 20rpx;
    color: #718096;
  }
  
  /* 课表主体 */
  .course-content {
    display: flex;
    background: #ffffff;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  }
  
  /* 左侧节次列 */
  .course-nums {
    width: 130rpx;
    background: #f8f9fa;
    border-right: 1rpx solid #f0f0f0;
  }
  .course-num {
    height: 120rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1rpx solid #f0f0f0;
    font-size: 20rpx;
    color: #4a5568;
    text-align: center;
    line-height: 1.2;
  }
  
  /* 右侧Swiper */
  .course-swpier {
    flex: 1;
    height: 1920rpx; /* 16节 × 120rpx */
  }
  .course-list {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0 8rpx;
  }
  
  /* 课程卡片 */
  .course-item {
    position: absolute;
    border-radius: 12rpx;
    overflow: hidden;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
    transition: all 0.2s ease;
  }
  .course-item:hover {
    transform: translateY(-2rpx);
    box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
  }
  .course-item__content {
    width: 100%;
    height: 100%;
    padding: 12rpx 8rpx;
    box-sizing: border-box;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .course-name {
    font-size: 24rpx;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 4rpx;
    display: block;
  }
  .course-address {
    font-size: 20rpx;
    opacity: 0.9;
    display: block;
  }