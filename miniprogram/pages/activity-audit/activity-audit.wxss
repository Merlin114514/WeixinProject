/* pages/activity-audit/activity-audit.wxss */
.audit-container {
    padding: 24rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  .audit-card {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .card-header {
    margin-bottom: 20rpx;
    border-bottom: 1rpx solid #f5f5f5;
    padding-bottom: 16rpx;
  }
  
  .card-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
  }
  
  .card-meta {
    font-size: 24rpx;
    color: #666;
  }
  
  .apply-count {
    font-size: 26rpx;
    color: #1a73e8;
    margin-bottom: 16rpx;
    font-weight: bold;
  }
  
  .apply-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #f5f5f5;
  }
  
  .apply-info {
    flex: 1;
  }
  
  .apply-username {
    font-size: 26rpx;
    color: #333;
  }
  
  .apply-time {
    font-size: 22rpx;
    color: #999;
    margin-top: 4rpx;
  }
  
  .apply-operation {
    display: flex;
    gap: 12rpx;
  }
  
  .agree-btn {
    padding: 8rpx 20rpx;
    background-color: #4caf50;
    color: #fff;
    font-size: 22rpx;
    border-radius: 8rpx;
    border: none;
  }
  
  .refuse-btn {
    padding: 8rpx 20rpx;
    background-color: #ff4d4f;
    color: #fff;
    font-size: 22rpx;
    border-radius: 8rpx;
    border: none;
  }
  
  .empty {
    text-align: center;
    padding: 40rpx 0;
    font-size: 26rpx;
    color: #999;
  }