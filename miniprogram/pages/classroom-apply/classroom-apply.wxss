.container {
    width: 100%;
    min-height: 100vh;
    background-color: #f5f7fa;
    padding: 20rpx;
    box-sizing: border-box;
  }
  
  .classroom-wrap, .student-wrap {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .title {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 15rpx;
  }
  
  .content {
    font-size: 26rpx;
    color: #666;
  }
  
  .form-wrap {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .form-item {
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #e5e7eb;
  }
  
  .form-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  .label {
    font-size: 28rpx;
    color: #333;
    display: block;
    margin-bottom: 10rpx;
  }
  
  .value {
    font-size: 26rpx;
    color: #666;
  }
  
  .input {
    font-size: 26rpx;
    color: #666;
    height: 80rpx;
    padding: 0 10rpx;
    box-sizing: border-box;
    border: 1rpx solid #e5e7eb;
    border-radius: 8rpx;
    width: 100%;
  }
  
  /* 确保picker可点击的样式 */
  .picker {
    font-size: 26rpx;
    color: #666;
    height: 80rpx;
    line-height: 80rpx;
    border: 1rpx solid #e5e7eb;
    border-radius: 8rpx;
    padding: 0 10rpx;
    margin-bottom: 15rpx;
    width: 100%;
    box-sizing: border-box;
    background-color: #fff;
  }
  
  .form-item .picker:last-child {
    margin-bottom: 0;
  }
  
  .textarea {
    font-size: 26rpx;
    color: #666;
    min-height: 150rpx;
    padding: 10rpx;
    box-sizing: border-box;
    border: 1rpx solid #e5e7eb;
    border-radius: 8rpx;
    resize: none;
    width: 100%;
  }
  
  .submit-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background-color: #07c160;
    color: #fff;
    border-radius: 16rpx;
    font-size: 28rpx;
    border: none;
    margin-top: 20rpx;
  }
  
  .submit-btn::after {
    border: none;
  }