page {
    background-color: #f5f7fa;
    font-size: 28rpx;
    height: 100%;
    box-sizing: border-box;
  }
  
  .page-container {
    padding: 0 20rpx;
    box-sizing: border-box;
  }
  
  /* 顶部用户信息区 */
  .user-header {
    margin: 30rpx 0;
    width: 100%;
  }
  .user-info-wrap {
    background: linear-gradient(135deg, #409eff, #67c23a);
    width: 100%;
    padding: 60rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(64, 158, 255, 0.2);
    position: relative;
    overflow: hidden;
  }
  .user-info-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
    opacity: 0.5;
    z-index: 0;
  }
  .avatar-wrap {
    position: relative;
    margin-bottom: 20rpx;
    z-index: 1;
  }
  .avatar {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    background-color: #fff;
    object-fit: cover;
    border: 4rpx solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  }
  .avatar-mask {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40rpx;
    line-height: 40rpx;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 22rpx;
    text-align: center;
    border-bottom-left-radius: 70rpx;
    border-bottom-right-radius: 70rpx;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  /* ✅ 适配真机触摸 */
  .avatar-wrap:active .avatar-mask,
  .avatar-wrap:hover .avatar-mask {
    opacity: 1;
  }
  .user-name {
    color: #fff;
    font-size: 36rpx;
    font-weight: 600;
    margin-bottom: 8rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
    z-index: 1;
    position: relative;
  }
  .user-role {
    color: rgba(255, 255, 255, 0.9);
    font-size: 28rpx;
    z-index: 1;
    position: relative;
  }
  
  /* 功能网格 */
  .func-grid {
    background: #fff;
    border-radius: 24rpx;
    padding: 40rpx 20rpx;
    margin-bottom: 30rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
    gap: 20rpx;
  }
  .func-item {
    width: calc(33.33% - 14rpx);
    height: 180rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 16rpx;
    background: #f8f9fa;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .func-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #409eff, #67c23a);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }
  .func-item:active {
    transform: translateY(-4rpx) scale(0.98);
    box-shadow: 0 8rpx 16rpx rgba(64, 158, 255, 0.2);
  }
  .func-item:active::before {
    opacity: 0.05;
  }
  .func-item.empty {
    background: transparent;
    box-shadow: none;
  }
  .func-item.empty:active {
    transform: none;
    box-shadow: none;
  }
  .func-icon {
    width: 80rpx;
    height: 80rpx;
    margin-bottom: 16rpx;
    object-fit: contain;
    z-index: 1;
  }
  .func-name {
    font-size: 26rpx;
    color: #333;
    text-align: center;
    font-weight: 500;
    z-index: 1;
  }
  .func-item:active .func-name {
    color: #409eff;
  }
  
  /* 退出登录按钮 */
  .logout-btn {
    width: 100%;
    background: #fff;
    color: #f56c6c;
    border: 1rpx solid #f56c6c;
    border-radius: 16rpx;
    padding: 16rpx 0;
    font-size: 30rpx;
    margin-bottom: 50rpx;
    transition: all 0.3s ease;
    box-shadow: 0 2rpx 10rpx rgba(245, 108, 108, 0.1);
  }
  .logout-btn::after {
    border: none;
  }
  .logout-btn:active {
    background: #fef2f2;
    transform: scale(0.98);
    box-shadow: 0 4rpx 16rpx rgba(245, 108, 108, 0.2);
  }