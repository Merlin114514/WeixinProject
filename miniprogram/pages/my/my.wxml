<!-- 页面整体容器 -->
<view class="page-container">
<!-- 顶部用户信息区（改为蓝色背景+头像+微信用户样式） -->
<view class="user-header">
  <!-- 蓝色背景的用户信息容器 -->
  <view class="user-info-wrap">
    <!-- 头像 -->
    <image class="avatar" src="/images/my.png" mode="widthFix"></image>
    <!-- 微信用户文字 -->
    <text class="wechat-text">微信用户</text>
  </view>
</view>
  <!-- 学校选课模块 -->
  <view class="course-card">
    <text class="card-title">学校选课</text>
    <view class="school-info">
      <image class="school-logo" src="/images/xiaohui.png" mode="widthFix"></image>
      <text class="school-name">广州软件学院</text>
      <view class="course-count">
        <text class="count-num">10</text>
        <text class="count-label">共享课</text>
      </view>
    </view>
  </view>

  <!-- 功能按钮区 -->
  <view class="func-grid">
    <view class="func-item" wx:for="{{funcList}}" wx:key="index">
      <image class="func-icon" src="{{item.icon}}" mode="widthFix"></image>
      <text class="func-name">{{item.name}}</text>
    </view>
  </view>
</view>