<view class="page-container">
  <view class="user-header">
    <view class="user-info-wrap">
      <view class="avatar-wrap" bindtap="chooseAvatar">
        <image 
          class="avatar" 
          src="{{userInfo.avatarUrl || '/images/my.png'}}"
          mode="aspectFill"
        />
        <view class="avatar-mask">更换头像</view>
      </view>
      <text class="user-name">{{userInfo.username || userInfo.nickName || userInfo.name || userInfo.studentId || userInfo.teaId || '未设置昵称'}}</text>
      <text class="user-role">当前身份：{{userInfo.role === 'student' ? '学生' : '教师'}}</text>
    </view>
  </view>

  <view class="func-grid">
    <block wx:if="{{userInfo.role === 'student'}}">
      <view 
        class="func-item" 
        wx:for="{{studentFuncs}}" 
        wx:key="name" 
        bindtap="clickFunc" 
        data-path="{{item.path}}"
        data-name="{{item.name}}"
      >
        <image class="func-icon" src="{{item.icon}}" mode="widthFix" />
        <text class="func-name">{{item.name}}</text>
      </view>
      <view class="func-item empty" wx:for="{{3 - (studentFuncs.length % 3)}}" wx:key="index" wx:if="{{studentFuncs.length % 3 !== 0}}"></view>
    </block>

    <block wx:if="{{userInfo.role === 'teacher'}}">
      <view 
        class="func-item" 
        wx:for="{{teacherFuncs}}" 
        wx:key="name" 
        bindtap="clickFunc" 
        data-path="{{item.path}}"
        data-name="{{item.name}}"
      >
        <image class="func-icon" src="{{item.icon}}" mode="widthFix" />
        <text class="func-name">{{item.name}}</text>
      </view>
      <view class="func-item empty" wx:for="{{3 - (teacherFuncs.length % 3)}}" wx:key="index" wx:if="{{teacherFuncs.length % 3 !== 0}}"></view>
    </block>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>