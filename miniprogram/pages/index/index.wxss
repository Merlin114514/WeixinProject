page {
    background-color: #f5f7fa;
    font-size: 28rpx;
    color: #333;
  }
  
  .page-container {
    padding: 24rpx 20rpx;
    background-color: transparent;
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  /* 轮播图区域 */
  .swiper-container {
    width: 100%;
    height: 360rpx;
    border-radius: 24rpx;
    overflow: hidden;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  }
  .swiper-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    will-change: transform;
    backface-visibility: hidden;
  }
  
  /* 轮播指示器 */
  .wx-swiper-dots {
    bottom: 20rpx !important;
  }
  .wx-swiper-dot {
    width: 10rpx !important;
    height: 10rpx !important;
    margin: 0 6rpx !important;
    background-color: rgba(255, 255, 255, 0.8) !important;
    border-radius: 50%;
    opacity: 0.7;
  }
  .wx-swiper-dot-active {
    width: 24rpx !important;
    border-radius: 8rpx !important;
    background-color: #ffffff !important;
    box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.9);
    opacity: 1;
    transition: all 0.3s ease;
  }
  
  /* 功能模块区域 */
  .func-container {
    display: flex;
    justify-content: space-between;
    gap: 20rpx;
    align-items: stretch;
    margin-bottom: 30rpx;
  }
  .func-left {
    width: calc(50% - 10rpx);
    display: flex;
    flex-direction: column;
    gap: 16rpx;
  }
  .func-card {
    flex: 1;
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 0;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  .func-card:active {
    transform: scale(0.97);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  }
  .func-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20rpx;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    will-change: transform;
    backface-visibility: hidden;
  }
  .func-right {
    width: calc(50% - 10rpx);
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border-radius: 20rpx;
    padding: 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease;
  }
  .func-right:active {
    transform: scale(0.97);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  }
  .quality-header {
    height: 0;
    margin-bottom: 0;
  }
  .quality-img {
    width: 100%;
    flex: 1;
    object-fit: cover;
    border-radius: 16rpx;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    will-change: transform;
    backface-visibility: hidden;
  }
  
  /* 我的课程区域（核心调整） */
  .my-course-container {
    margin-top: 0;
    background-color: #fff;
    padding: 24rpx 20rpx;
    border-radius: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  }
  .course-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
    padding-bottom: 16rpx;
    border-bottom: 1px solid #f0f0f0;
  }
  .course-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #222;
    display: flex;
    align-items: center;
  }
  .course-title::after {
    content: '';
    display: inline-block;
    width: 8rpx;
    height: 32rpx;
    background-color: #ffc53d;
    border-radius: 4rpx;
    margin-right: 12rpx;
  }
  .course-more {
    font-size: 26rpx;
    color: #ffc53d;
    padding: 6rpx 12rpx;
    background-color: #fff8e6;
    border-radius: 16rpx;
    transition: color 0.2s ease;
  }
  .course-more:active {
    color: #e8b02d;
    background-color: #fff3cc;
  }
  .course-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  .course-item {
    position: relative;
    background: #fff;
    border-radius: 20rpx;
    box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.03);
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid #f8f8f8;
    /* 卡片总高度适配示例 */
    height: 280rpx;
    display: flex;
    flex-direction: column;
  }
  
/* 调整课程封面图比例（更高） */
.course-img {
    width: 100%;
    height: 220rpx; /* 从200rpx提高到220rpx，增加高度 */
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
    /* 调整宽高比为 4:3（更高，原4:2.5） */
    aspect-ratio: 4 / 3;
  }
  
  /* 同步调整课程卡片总高度（适配更高的封面） */
  .course-item {
    position: relative;
    background: #fff;
    border-radius: 20rpx;
    box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.03);
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid #f8f8f8;
    /* 总高度从280rpx调整为300rpx，匹配更高的封面 */
    height: 400rpx;
    display: flex;
    flex-direction: column;
  }
  
  .course-tag {
    position: absolute;
    top: 15rpx;
    right: 15rpx;
    background: #ffc53d;
    color: #fff;
    font-size: 22rpx;
    padding: 6rpx 12rpx;
    border-radius: 8rpx;
    font-weight: 500;
    box-shadow: 0 2rpx 8rpx rgba(255, 197, 61, 0.3);
  }
  
  /* 底部文字更清晰 */
  .course-name {
    font-size: 30rpx; /* 加大字号提升清晰度 */
    color: #1a1a1a; /* 加深文字颜色 */
    padding: 10rpx 15rpx;
    font-weight: 500;
    line-height: 40rpx;
    /* 防止文字换行 */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .course-btn-bar {
    display: flex;
    border-top: 1px solid #f5f5f5;
    height: 60rpx;
  }
  .course-btn {
    flex: 1;
    text-align: center;
    font-size: 26rpx; /* 加大按钮文字 */
    color: #555; /* 加深按钮文字颜色 */
    padding: 14rpx 0;
    transition: all 0.2s ease;
    position: relative;
    font-weight: 450; /* 轻微加粗 */
  }
  .course-btn:active {
    background-color: #f8f8f8;
    color: #ffc53d;
  }
  .course-btn:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 14rpx;
    height: 30rpx;
    width: 1px;
    background-color: #e5e5e5; /* 加深分割线 */
  }
  
  .load-more-btn {
    margin-top: 24rpx;
    text-align: center;
    font-size: 28rpx;
    color: #ffc53d;
    padding: 16rpx 0;
    background: #fff8e6;
    border-radius: 12rpx;
    font-weight: 500;
    transition: all 0.3s ease;
  }
  .load-more-btn:active {
    background: #fff3cc;
    color: #e8b02d;
    transform: scale(0.98);
  }