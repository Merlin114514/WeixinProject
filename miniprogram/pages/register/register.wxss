.container {
    width: 100%;
    min-height: 100vh;
    padding: 60rpx 40rpx;
    box-sizing: border-box;
    background-color: #f5f7fa;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .register-title {
    font-size: 40rpx;
    font-weight: 600;
    color: #2d3748;
    margin-bottom: 80rpx;
  }
  
  /* 身份选择样式（与登录页一致） */
  .role-select {
    display: flex;
    justify-content: center;
    gap: 40rpx;
    margin-bottom: 60rpx;
    width: 100%;
  }
  
  .role-item {
    font-size: 32rpx;
    color: #718096;
    padding: 10rpx 30rpx;
    border-radius: 30rpx;
    transition: all 0.3s ease;
  }
  
  .role-item.active {
    color: #409eff;
    font-weight: 600;
    background-color: #e6f7ff;
  }

  /* 新增：头像上传样式 */
  .avatar-wrap {
    width: 140rpx;
    height: 140rpx;
    margin: 0 auto 60rpx; /* 居中显示，上下留白 */
    position: relative;
  }
  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%; /* 圆形头像 */
    object-fit: cover; /* 保持图片比例，裁剪多余部分 */
    border: 2rpx solid #e2e8f0; /* 浅灰色边框，提升美观度 */
  }
  .avatar-tip {
    position: absolute;
    bottom: -30rpx;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 24rpx;
    color: #718096; /* 灰色提示文字 */
  }
  
  /* 输入框样式（与登录页一致） */
  .input-wrap {
    width: 100%;
    margin-bottom: 40rpx;
    display: flex;
    flex-direction: column;
    gap: 10rpx;
  }
  
  .input-label {
    font-size: 28rpx;
    color: #2d3748;
    font-weight: 500;
  }
  
  .input-content {
    width: 100%;
    height: 80rpx;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 0 20rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  /* 注册按钮样式 */
  .register-btn {
    width: 100%;
    height: 90rpx;
    line-height: 90rpx;
    background-color: #409eff;
    color: #fff;
    font-size: 32rpx;
    border-radius: 45rpx;
    margin-bottom: 60rpx;
    box-shadow: 0 4rpx 16rpx rgba(64,158,255,0.3);
  }
  
  .register-btn::after {
    border: none;
  }
  
  /* 返回登录提示样式 */
  .login-tip {
    font-size: 28rpx;
    color: #4299e1;
  }
  
  .login-tip:active {
    color: #38b2ac;
  }