/* pages/activity/activity.wxss */
.container {
    padding: 16rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  .tab-scroll {
    white-space: nowrap;
    margin-bottom: 20rpx;
  }
  
  .tab-item {
    display: inline-block;
    padding: 12rpx 32rpx;
    margin-right: 16rpx;
    background-color: #fff;
    border-radius: 30rpx;
    font-size: 28rpx;
    color: #333;
  }
  
  .tab-item.active {
    background-color: #1a73e8;
    color: #fff;
  }
  
  .new-notice {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
    padding: 16rpx;
    background-color: #fff;
    border-radius: 16rpx;
  }
  
  .notice-icon {
    width: 32rpx;
    height: 32rpx;
    margin-right: 12rpx;
  }
  
  .notice-text {
    font-size: 26rpx;
    color: #ff6700;
    font-weight: bold;
  }
  
  .activity-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  
  .activity-card {
    width: 354rpx;
    background-color: #fff;
    border-radius: 16rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .activity-img {
    width: 100%;
    height: 200rpx;
    object-fit: cover;
    background-color: #eee;
  }
  
  .activity-info {
    padding: 16rpx;
  }
  
  .activity-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .activity-meta {
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 8rpx;
  }
  
  .activity-location {
    font-size: 24rpx;
    color: #999;
    margin-bottom: 12rpx;
  }
  
  .activity-count {
    font-size: 24rpx;
    color: #1a73e8;
    margin-bottom: 8rpx;
  }
  
  .activity-status {
    display: inline-block;
    padding: 4rpx 12rpx;
    font-size: 22rpx;
    color: #fff;
    border-radius: 12rpx;
  }
  
  .status-end {
    background-color: #999;
  }
  
  .status-full {
    background-color: #ff4d4f;
  }
  
  .empty {
    width: 100%;
    text-align: center;
    padding: 100rpx 0;
    font-size: 28rpx;
    color: #999;
  }